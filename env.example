# Notion API Configuration
# Get your API key from: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# Get the database ID from the URL when viewing your database in Notion
# Example: https://www.notion.so/myworkspace/a8aec43384f447ed84390e8e42c2e089
# The database ID is: a8aec43384f447ed84390e8e42c2e089
NOTION_DATABASE_ID=your_database_id_here

# Notion API v5 queries a data source. If omitted, the app will resolve the
# first data source from NOTION_DATABASE_ID.
NOTION_DATA_SOURCE_ID=your_data_source_id_here

# Public canonical URL used for metadata, sitemap, and social previews.
NEXT_PUBLIC_SITE_URL=https://levon.blog
