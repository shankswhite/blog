# Notion build-time content sync. Use one Content data source with a Type
# property (Writing / Project). Never prefix secrets with NEXT_PUBLIC_.
NOTION_CONTENT_DATA_SOURCE_ID=your_data_source_id_here

# Local development: put the read-only integration token in .env.local.
NOTION_API_KEY=your_notion_api_key_here

# Amplify (recommended): keep the token in SSM SecureString and expose only
# the parameter name to the build. This takes precedence over inline secrets.
NOTION_API_KEY_SSM_PATH=

# Backward-compatible alias for NOTION_CONTENT_DATA_SOURCE_ID.
NOTION_DATA_SOURCE_ID=

# Notion connection webhook bridge. Both modes are disabled by default.
# During the one-time handshake only, set setup mode to true. The endpoint
# writes the verification token directly to the configured SSM SecureString
# path and never prints it in application logs. Turn setup mode off immediately.
NOTION_WEBHOOK_SETUP_MODE=false
NOTION_WEBHOOK_VERIFICATION_TOKEN=
NOTION_WEBHOOK_VERIFICATION_TOKEN_SSM_PATH=

# Strict scope checks are recommended in production. Signed events must match.
NOTION_WEBHOOK_WORKSPACE_ID=
NOTION_WEBHOOK_SUBSCRIPTION_ID=

# Enables a server-side POST to the existing Amplify incoming build webhook.
# Never prefix either variable with NEXT_PUBLIC_.
NOTION_AUTO_PUBLISH_ENABLED=false
# The current duplicate-event cache is process-local. This second opt-in makes
# the possible extra Amplify build-minute usage explicit; leave false unless
# that tradeoff is approved or persistent coalescing has been added.
NOTION_ALLOW_BEST_EFFORT_DEDUPLICATION=false
AMPLIFY_BUILD_WEBHOOK_URL=
AMPLIFY_BUILD_WEBHOOK_URL_SSM_PATH=

# Public canonical URL used for metadata, sitemap, and social previews.
NEXT_PUBLIC_SITE_URL=https://www.levon.blog
