LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=kira-portfolio
GOOGLE_API_KEY=
ELEVEN_API_KEY=

# Optional model and voice overrides.
STT_PROVIDER=livekit
LIVEKIT_STT_MODEL=deepgram/nova-3
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# Only required when STT_PROVIDER=deepgram instead of the default LiveKit
# Inference route.
DEEPGRAM_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite
ELEVEN_VOICE_ID=
ELEVEN_MODEL_ID=eleven_flash_v2_5

# Optional deployment override. When absent, the agent reads the committed
# public portfolio_context.md file.
COMPANION_CONTEXT=
